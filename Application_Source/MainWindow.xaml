<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AstroArchive" Width="1280" Height="880" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F2F5FA" FontFamily="Segoe UI" FontSize="13" Foreground="#243247" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#4D55C7"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#243247"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6489EA"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,9"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#4D55C7"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E3"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AlternatingRowBackground" Value="#F6F8FC"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF1F8"/><Setter Property="Foreground" Value="#536278"/><Setter Property="Padding" Value="10,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E5EBFF"/><Setter Property="Foreground" Value="#172A4D"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#4D55C7"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="22,10"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#5C6D83"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="Transparent" CornerRadius="9" Margin="0,0,8,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E3E9FC"/><Setter Property="Foreground" Value="#343C9E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#EAF0F8"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#4D55C7"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="5,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E5EBFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EDF2FA"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#4D55C7"/><Setter TargetName="ItemSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border CornerRadius="14" Padding="20,13">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#111C37" Offset="0"/><GradientStop Color="#202C55" Offset="0.7"/><GradientStop Color="#31366A" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image x:Name="BrandLogo" Width="66" Height="66" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="AstroArchive" FontSize="29" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Capture library  /  Target discovery  /  Stacking projects" Foreground="#C2D2EB" FontSize="12" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SettingsButton" Content="Settings" Background="#293856" BorderBrush="#627490" Foreground="White"/><Button x:Name="HelpButton" Content="Guide" Background="#293856" BorderBrush="#627490" Foreground="White" Margin="0"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#D9E1ED" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,15,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVE REPOSITORY" FontSize="10" FontWeight="SemiBold" Foreground="#536278"/><TextBlock x:Name="RepositoryLabel" Text="Choose a folder to begin" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" x:Name="RepositoryButton" Content="Choose folder" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></Border>
  <TabControl Grid.Row="2" x:Name="MainTabs" Background="Transparent" BorderThickness="0">
   <TabItem Header="Capture library"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="155"/><ColumnDefinition Width="140"/><ColumnDefinition Width="135"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="Search targets, dates, device IDs, makes, filters, exposure, filenames and notes. All words must match."/><ComboBox x:Name="MakeFilter" Grid.Column="1" Margin="8,0,0,0"/><ComboBox x:Name="TelescopeFilter" Grid.Column="2" Margin="8,0,0,0"/><ComboBox x:Name="KindFilter" Grid.Column="3" Margin="8,0,0,0"/><ComboBox x:Name="MountFilter" Grid.Column="4" Margin="8,0,0,0"/><Button Grid.Column="5" x:Name="ClearButton" Content="Clear" Margin="8,0,0,0"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="White" CornerRadius="10" BorderBrush="#D9E1ED" BorderThickness="1" Margin="0,0,13,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="YOUR TARGETS" FontSize="10" FontWeight="SemiBold" Foreground="#536278" Margin="15,15,0,10"/><ListBox x:Name="TargetList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#5E7089" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" CornerRadius="10" BorderBrush="#D9E1ED" BorderThickness="1" ClipToBounds="True"><Grid><DataGrid x:Name="FramesGrid"><DataGrid.Columns><DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="105"/><DataGridTextColumn Header="MAKE" Binding="{Binding MakeText}" Width="95"/><DataGridTextColumn Header="DEVICE" Binding="{Binding Telescope}" Width="120"/><DataGridTextColumn Header="FRAME" Binding="{Binding Kind}" Width="105"/><DataGridTextColumn Header="MOUNT" Binding="{Binding Mount}" Width="125"/><DataGridTextColumn Header="NIGHT" Binding="{Binding Night}" Width="110"/><DataGridTextColumn Header="EXPOSURE" Binding="{Binding ExposureText}" Width="82"/><DataGridTextColumn Header="FILTER" Binding="{Binding Filter}" Width="100"/><DataGridTextColumn Header="CAMERA" Binding="{Binding Camera}" Width="95"/><DataGridTextColumn Header="GAIN" Binding="{Binding GainText}" Width="65"/><DataGridTextColumn Header="TEMP" Binding="{Binding TemperatureText}" Width="80"/><DataGridTextColumn Header="CALIBRATION" Binding="{Binding Calibration}" Width="110"/><DataGridTextColumn Header="DIMENSIONS" Binding="{Binding SizeText}" Width="120"/><DataGridTextColumn Header="FILE" Binding="{Binding OriginalName}" Width="300"/></DataGrid.Columns></DataGrid><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Add your first captures" FontSize="21" FontWeight="SemiBold" Foreground="#273758" HorizontalAlignment="Center"/><TextBlock Text="Import a telescope mirror, then explore your captures." Foreground="#5E7089" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Border><Border Grid.Row="1" Background="#EAF0F8" CornerRadius="8" Padding="12" Margin="0,11,0,0"><TextBlock x:Name="DetailsLabel" Text="Select a capture to view its instrument, target and classification evidence." TextWrapping="Wrap" Foreground="#4D607C" MaxHeight="86"/></Border></Grid>
    </Grid>
    <WrapPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="ExportButton" Content="Create stacking project" Background="#4D55C7" Foreground="White" BorderBrush="#4D55C7"/><Button x:Name="RotationButton" Content="Analyze rotation"/><Button x:Name="SolveButton" Content="Identify target" ToolTip="Use a recognised filename target first; otherwise plate solve."/><Button x:Name="EditButton" Content="Edit metadata"/><Button x:Name="MoreButton" Content="Repository tools" Margin="0"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="Import captures"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#D9E1ED" BorderThickness="1" CornerRadius="10" Padding="17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="180"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOURCE FOLDER" FontSize="10" Foreground="#536278" FontWeight="SemiBold"/><DockPanel Margin="0,8,12,0"><Button DockPanel.Dock="Right" x:Name="SourceButton" Content="Browse" Padding="12,8" Margin="8,0,0,0"/><TextBox x:Name="SourceBox" ToolTip="Your mirrored telescope folder, including a mounted Google Drive folder."/></DockPanel></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="PHYSICAL DEVICE ID" FontSize="10" Foreground="#536278" FontWeight="SemiBold"/><TextBox x:Name="TelescopeBox" Margin="0,8,0,0" Text="Telescope-01" ToolTip="Use a unique ID for each physical telescope. Make is detected separately."/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="MODEL OVERRIDE" FontSize="10" Foreground="#536278" FontWeight="SemiBold"/><ComboBox x:Name="ModelBox" Margin="0,8,0,0" ToolTip="Auto detects each file from instrument metadata and folder structure."/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="CAMERA" FontSize="10" Foreground="#536278" FontWeight="SemiBold"/><ComboBox x:Name="CameraBox" Margin="0,8,0,0"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,10,0,0"><StackPanel><CheckBox x:Name="DeleteOriginalsCheck" IsChecked="False" FontWeight="SemiBold" Content="Delete originals after verified import" ToolTip="Deletes newly imported FITS from the source folder after verification and indexing. Deletions in a cloud-synced source folder will sync too."/><TextBlock Text="Off by default. Duplicates, session metadata and other files stay in the source folder." Foreground="#5E7089" FontSize="11" Margin="20,5,0,0" TextWrapping="Wrap"/></StackPanel><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF0F8"/><Setter Property="BorderBrush" Value="#D9E1ED"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=DeleteOriginalsCheck}" Value="True"><Setter Property="Background" Value="#FFF0DD"/><Setter Property="BorderBrush" Value="#D89E59"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
    <Grid Grid.Row="2" Margin="0,10,0,11"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="TARGET ANALYSIS" FontSize="10" FontWeight="SemiBold" Foreground="#536278"/><ComboBox x:Name="ImportSolveMode" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ROTATION ANALYSIS" FontSize="10" FontWeight="SemiBold" Foreground="#536278"/><ComboBox x:Name="ImportRotationMode" Margin="0,5,0,0"/></StackPanel></Grid>
     <WrapPanel Grid.Row="1" Margin="0,8,0,8"><CheckBox x:Name="CloudSourceCheck" Content="Streamed/cloud source" Margin="0,0,18,0" ToolTip="Use this if your Drive provider does not report offline placeholders. Provider reads/download waits are measured separately. Making the source available offline avoids downloads."/><CheckBox x:Name="RetuneCheck" Content="Retune copy workers" Margin="0,0,18,0"/><TextBlock Text="Analysis is optional and can take much longer." Foreground="#755522" FontSize="11"/></WrapPanel>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ScanLabel" Text="Scan once to review captures. New file hashes are calculated while copying." VerticalAlignment="Center" Foreground="#536278" TextWrapping="Wrap" Margin="0,0,14,0"/><Button Grid.Column="1" x:Name="ScanButton" Content="Scan folder" Margin="0"/></Grid>
    </Grid>
    <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#D9E1ED" BorderThickness="1"><DataGrid x:Name="ImportGrid"><DataGrid.Columns><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="115"/><DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="125"/><DataGridTextColumn Header="MAKE / MODEL" Binding="{Binding InstrumentText}" Width="185"/><DataGridTextColumn Header="FRAME TYPE" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="CAMERA" Binding="{Binding Camera}" Width="95"/><DataGridTextColumn Header="NIGHT" Binding="{Binding Night}" Width="105"/><DataGridTextColumn Header="EXPOSURE" Binding="{Binding ExposureText}" Width="82"/><DataGridTextColumn Header="FILE" Binding="{Binding OriginalName}" Width="*" MinWidth="200"/></DataGrid.Columns></DataGrid></Border>
    <WrapPanel Grid.Row="4" Margin="0,14,0,0"><Button x:Name="ImportButton" Content="Import new files" Background="#4D55C7" Foreground="White" BorderBrush="#4D55C7"/><Button x:Name="ImportEditButton" Content="Edit selected"/><Button x:Name="ImportSolveButton" Content="Identify target" ToolTip="Recognised filename names need no solver. Unknown labels use plate solving."/><Button x:Name="ScanErrorsButton" Content="Scan report" Margin="0"/></WrapPanel>
   </Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="3" Margin="0,10,0,0"><Expander Header="Performance details" FontSize="11" Foreground="#4D607C"><DataGrid x:Name="MetricsGrid" MaxHeight="135" MinHeight="80" RowHeight="25" FontSize="11" Margin="0,7,0,8"><DataGrid.Columns><DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="*"/><DataGridTextColumn Header="FILES" Binding="{Binding Files}" Width="75"/><DataGridTextColumn Header="SECONDS" Binding="{Binding Seconds, StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="FILES/S" Binding="{Binding FilesPerSecond, StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="MB/S" Binding="{Binding MBPerSecond, StringFormat=0.00}" Width="90"/></DataGrid.Columns></DataGrid></Expander>
   <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusLabel" Text="Ready" Foreground="#4D607C" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock x:Name="RateLabel" Text="Rates and estimated time appear during processing." FontSize="11" Foreground="#536278" Margin="0,4,0,0"/></StackPanel><ProgressBar x:Name="ProgressBar" Grid.Column="1" Height="6" VerticalAlignment="Center" Foreground="#4D55C7" Background="#D9E1ED" BorderThickness="0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="PerformanceButton" Content="Report" Padding="12,5" Margin="12,0,0,0"/><Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Padding="12,5" Margin="8,0,0,0"/></StackPanel></Grid>
  </StackPanel>
 </Grid>
</Window>
