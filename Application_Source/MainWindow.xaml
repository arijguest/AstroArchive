 </Window.Resources>
 <Grid Margin="18,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="BrandLogo" Width="34" Height="34" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
   <TextBlock Grid.Column="1" Text="AstroArchive" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,22,0"/>
   <TextBlock Grid.Column="2" x:Name="RepositoryLabel" Text="Set an archive folder in Settings" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" MaxWidth="650" HorizontalAlignment="Left"/>
   <StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="ThemeButton" Content="◐" ToolTip="Switch light / dark mode" Padding="10,6"/><Button x:Name="SettingsButton" Content="Settings"/><Button x:Name="HelpButton" Content="Guide" Margin="0"/></StackPanel>
  </Grid>
  <TabControl Grid.Row="2" x:Name="MainTabs">
   <TabItem Header="Library"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Capture library" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="LibraryCount" Foreground="{DynamicResource Muted}" Margin="12,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ExportButton" Content="Export ▾" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White"/><Button x:Name="PreviewToggle" Content="Preview"/><Button x:Name="MoreButton" Content="Tools ▾" Margin="0"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="135"/><ColumnDefinition Width="120"/><ColumnDefinition Width="115"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" ToolTip="Search target, date, device, filter, filename or notes"/><TextBlock x:Name="SearchHint" Text="Search captures…" Foreground="{DynamicResource Muted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><ComboBox x:Name="MakeFilter" Grid.Column="1" Margin="6,0,0,0"/><ComboBox x:Name="TelescopeFilter" Grid.Column="2" Margin="6,0,0,0"/><ComboBox x:Name="KindFilter" Grid.Column="3" Margin="6,0,0,0"/><ComboBox x:Name="MountFilter" Grid.Column="4" Margin="6,0,0,0"/><Button Grid.Column="5" x:Name="ClearButton" Content="Clear" Margin="6,0,0,0"/></Grid>
    <Grid Grid.Row="2" x:Name="LibraryBody"><Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition x:Name="PreviewDividerColumn" Width="10"/><ColumnDefinition x:Name="PreviewColumn" Width="330" MinWidth="0"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,10,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="TARGETS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="12,13,0,8"/><ListBox x:Name="TargetList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
     <Border Grid.Column="1" Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True"><Grid><DataGrid x:Name="FramesGrid"><DataGrid.Columns><DataGridTextColumn Header="FILE" Binding="{Binding OriginalName}" Width="*" MinWidth="175"/><DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="85"/><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="80"/><DataGridTextColumn Header="NIGHT" Binding="{Binding Night}" Width="96"/><DataGridTextColumn Header="EXPOSURE" Binding="{Binding ExposureText}" Width="76"/><DataGridTextColumn Header="FILTER" Binding="{Binding Filter}" Width="85"/></DataGrid.Columns></DataGrid><StackPanel x:Name="EmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><TextBlock Text="Your sky, organised." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Choose an archive in Settings, then import captures." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel></Grid></Border>
     <GridSplitter x:Name="PreviewDivider" Grid.Column="2" Width="4" HorizontalAlignment="Center" Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext"/>
     <Border Grid.Column="3" x:Name="PreviewPane" Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><Button DockPanel.Dock="Right" x:Name="OpenPreviewButton" Content="Open image…" FontSize="11" Padding="8,5" Margin="0" ToolTip="Preview FITS, XISF, TIFF, PNG, JPEG and Windows-codec images"/><TextBlock Text="IMAGE PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Grid.Row="1" x:Name="PreviewName" Text="Select a capture" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,10,0,8"/>
      <Border Grid.Row="2" Background="#05080F" CornerRadius="5" ClipToBounds="True"><Grid x:Name="PreviewStage"><ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/></ScrollViewer><TextBlock x:Name="PreviewMessage" Text="Select a file or open an image.

FITS · XISF · TIFF · PNG · JPEG" Foreground="#A8B5CD" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="18"/></Grid></Border>
      <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DISPLAY STRETCH" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/><ComboBox x:Name="StretchMode" ToolTip="Preview only. Auto links RGB channels to preserve colour; Auto per channel balances the background."/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="ZOOM" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/><ComboBox x:Name="PreviewZoom"/></StackPanel></Grid>
      <StackPanel Grid.Row="4"><TextBlock x:Name="PreviewInfo" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/><Expander Header="Capture details" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"><ScrollViewer MaxHeight="130"><TextBlock x:Name="DetailsLabel" Text="Select a capture to view metadata." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/></ScrollViewer></Expander></StackPanel>
     </Grid></Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RotationButton" Content="Rotation" Padding="10,5"/><Button x:Name="SolveButton" Content="Identify target" Padding="10,5"/><Button x:Name="EditButton" Content="Edit metadata" Padding="10,5" Margin="0"/></StackPanel><TextBlock x:Name="SelectionLabel" Text="Ctrl / Shift to select · Right-click for file actions" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
   </Grid></TabItem>
   <TabItem Header="Import captures"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="180"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOURCE FOLDER" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><DockPanel Margin="0,8,12,0"><Button DockPanel.Dock="Right" x:Name="SourceButton" Content="Browse" Padding="12,8" Margin="8,0,0,0"/><TextBox x:Name="SourceBox" ToolTip="Your mirrored telescope folder, including a mounted Google Drive folder."/></DockPanel></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="PHYSICAL DEVICE ID" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><TextBox x:Name="TelescopeBox" Margin="0,8,0,0" Text="Telescope-01" ToolTip="Use a unique ID for each physical telescope. Make is detected separately."/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="MODEL OVERRIDE" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><ComboBox x:Name="ModelBox" Margin="0,8,0,0" ToolTip="Auto detects each file from instrument metadata and folder structure."/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="CAMERA" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><ComboBox x:Name="CameraBox" Margin="0,8,0,0"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,10,0,0"><StackPanel><CheckBox x:Name="DeleteOriginalsCheck" IsChecked="False" FontWeight="SemiBold" Content="Delete originals after verified import" ToolTip="Deletes newly imported FITS from the source folder after verification and indexing. Deletions in a cloud-synced source folder will sync too."/><TextBlock Text="Off by default. Duplicates, session metadata and other files stay in the source folder." Foreground="{DynamicResource Muted}" FontSize="11" Margin="20,5,0,0" TextWrapping="Wrap"/></StackPanel><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=DeleteOriginalsCheck}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
    <Grid Grid.Row="2" Margin="0,10,0,11"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="TARGET ANALYSIS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="ImportSolveMode" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ROTATION ANALYSIS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="ImportRotationMode" Margin="0,5,0,0"/></StackPanel></Grid>
     <WrapPanel Grid.Row="1" Margin="0,8,0,8"><CheckBox x:Name="CloudSourceCheck" Content="Streamed/cloud source" Margin="0,0,18,0" ToolTip="Use this if your Drive provider does not report offline placeholders. Provider reads/download waits are measured separately. Making the source available offline avoids downloads."/><CheckBox x:Name="RetuneCheck" Content="Retune copy workers" Margin="0,0,18,0"/><TextBlock Text="Analysis is optional and can take much longer." Foreground="{DynamicResource Muted}" FontSize="11"/></WrapPanel>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ScanLabel" Text="Scan once to review captures. New file hashes are calculated while copying." VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,14,0"/><Button Grid.Column="1" x:Name="ScanButton" Content="Scan folder" Margin="0"/></Grid>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1"><DataGrid x:Name="ImportGrid"><DataGrid.Columns><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="115"/><DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="125"/><DataGridTextColumn Header="MAKE / MODEL" Binding="{Binding InstrumentText}" Width="185"/><DataGridTextColumn Header="FRAME TYPE" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="CAMERA" Binding="{Binding Camera}" Width="95"/><DataGridTextColumn Header="NIGHT" Binding="{Binding Night}" Width="105"/><DataGridTextColumn Header="EXPOSURE" Binding="{Binding ExposureText}" Width="82"/><DataGridTextColumn Header="FILE" Binding="{Binding OriginalName}" Width="*" MinWidth="200"/></DataGrid.Columns></DataGrid></Border>
    <WrapPanel Grid.Row="4" Margin="0,10,0,0"><Button x:Name="ImportButton" Content="Import new files" Background="{DynamicResource Accent}" Foreground="White" BorderBrush="{DynamicResource Accent}"/><Button x:Name="ImportEditButton" Content="Edit selected"/><Button x:Name="ImportSolveButton" Content="Identify target" ToolTip="Recognised filename names need no solver. Unknown labels use plate solving."/><Button x:Name="ScanErrorsButton" Content="Scan report" Margin="0"/></WrapPanel>
   </Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="3" Margin="0,10,0,0"><Expander Header="Performance details" FontSize="11" Foreground="{DynamicResource Muted}"><DataGrid x:Name="MetricsGrid" MaxHeight="135" MinHeight="80" RowHeight="25" FontSize="11" Margin="0,7,0,8"><DataGrid.Columns><DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="*"/><DataGridTextColumn Header="FILES" Binding="{Binding Files}" Width="75"/><DataGridTextColumn Header="SECONDS" Binding="{Binding Seconds, StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="FILES/S" Binding="{Binding FilesPerSecond, StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="MB/S" Binding="{Binding MBPerSecond, StringFormat=0.00}" Width="90"/></DataGrid.Columns></DataGrid></Expander>
   <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock x:Name="RateLabel" Text="Rates and estimated time appear during processing." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><ProgressBar x:Name="ProgressBar" Grid.Column="1" Height="6" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" BorderThickness="0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="PerformanceButton" Content="Report" Padding="12,5" Margin="12,0,0,0"/><Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Padding="12,5" Margin="8,0,0,0"/></StackPanel></Grid>
  </StackPanel>
 </Grid>
</Window>
