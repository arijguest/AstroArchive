   </Grid></TabItem>
   <TabItem Header="Import"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><WrapPanel Margin="0,0,0,8"><TextBlock Text="SAVED TELESCOPE" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="SavedTelescopeBox" Width="220" Margin="0,0,10,0" ToolTip="Select a saved physical telescope. Recover profiles from repository captures."/><Button x:Name="SaveTelescopeButton" Content="Save telescope" Padding="10,6"/><Button x:Name="RenameTelescopeButton" Content="Rename" Padding="10,6"/><Button x:Name="RebuildTelescopesButton" Content="Recover profiles" Padding="10,6"/><Button x:Name="RefreshUsbButton" Content="Refresh USB" Padding="10,6" Margin="0"/></WrapPanel><DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" x:Name="AutoUploadButton" Content="Auto upload from USB" Visibility="Collapsed" Background="{DynamicResource Accent}" Foreground="White" Margin="8,0,0,0"/><TextBlock x:Name="UsbStatusLabel" Text="Connect a telescope by USB, or browse its capture folder and save the telescope." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0"><TextBlock Text="SOURCE FOLDER" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" x:Name="SourceButton" Content="Browse" Padding="12,8" Margin="8,0,0,0"/><TextBox x:Name="SourceBox" ToolTip="Telescope or mirrored folder, including mounted cloud folders."/></DockPanel></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="DEVICE ID" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><TextBox x:Name="TelescopeBox" Margin="0,6,0,0" Text="Telescope-01" ToolTip="Use a unique ID for each physical telescope."/></StackPanel><Button Grid.Column="2" x:Name="ScanButton" Content="Scan folder" VerticalAlignment="Bottom" Margin="0"/>
    </Grid></StackPanel></Border>
    <Expander Grid.Row="1" Header="Import options" Margin="4,10,4,10" Foreground="{DynamicResource Muted}"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="MODEL" FontSize="10"/><ComboBox x:Name="ModelBox" Margin="0,5,0,0" ToolTip="Auto detects the model from each capture."/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="CAMERA" FontSize="10"/><ComboBox x:Name="CameraBox" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="TARGET ANALYSIS" FontSize="10"/><ComboBox x:Name="ImportSolveMode" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="ROTATION ANALYSIS" FontSize="10"/><ComboBox x:Name="ImportRotationMode" Margin="0,5,0,0"/></StackPanel>
     </Grid>
     <CheckBox x:Name="IgnoreFailedCheck" IsChecked="False" Content="Ignore failed" Margin="0,12,0,0" ToolTip="Skip FITS filenames containing 'failed' anywhere, regardless of case. Saved for future folder, USB and Dump imports. Ignored source files are kept."/>
     <CheckBox x:Name="DeleteOriginalsCheck" IsChecked="False" Content="Delete originals after verified import" Margin="0,10,0,0" ToolTip="Off by default. Removes newly imported source FITS only after verification and indexing. Cloud-synced source deletions propagate."/>
     <TextBlock Text="Originals are kept by default. Optional analysis can take longer." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
    </StackPanel></Border></Expander>
    <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid><TextBox x:Name="ImportSearchBox" ToolTip="Search the scan results. Only ready files in this filtered view are imported."/><TextBlock x:Name="ImportSearchHint" Text="Search import results…" Foreground="{DynamicResource Muted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
     <Button Grid.Column="1" x:Name="ImportFiltersButton" Content="Filters ▾" Margin="8,0,0,0"/><Button Grid.Column="2" x:Name="ImportClearButton" Content="Clear" Margin="8,0,0,0"/><Button Grid.Column="3" x:Name="ScreenImportsButton" Content="Screen for failures" Margin="8,0,0,0" ToolTip="Check the visible captures for telescope failure/rejection markers and unreadable FITS data."/>
    </Grid><StackPanel Grid.Row="1" Margin="2,8,0,0"><TextBlock x:Name="ImportSummaryLabel" TextWrapping="Wrap"/><TextBlock x:Name="ScanLabel" Text="Choose a source folder and scan to begin." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><WrapPanel Grid.Row="2" Margin="2,8,0,0"><CheckBox x:Name="SkipFlaggedCheck" Content="Skip flagged captures" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,8"/><Button x:Name="ReviewImportsButton" Content="Review flagged captures" Padding="12,6" Margin="0,0,8,8"/><Button x:Name="RetryImportsButton" Content="Retry failed imports" Padding="12,6" Margin="0,0,0,8"/></WrapPanel></Grid>
    <Border Grid.Row="3" Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True"><DataGrid x:Name="ImportGrid"><DataGrid.Columns><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="REVIEW" Binding="{Binding ReviewText}" Width="115"/><DataGridTextColumn Header="OBJECT ID" Binding="{Binding ObjectId}" Width="90"/><DataGridTextColumn Header="COMMON NAME / LABEL" Binding="{Binding TargetName}" Width="220"/><DataGridTextColumn Header="DEVICE / MODEL" Binding="{Binding InstrumentText}" Width="150"/><DataGridTextColumn Header="FRAME TYPE" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="FORMAT" Binding="{Binding Format}" Width="65"/><DataGridTextColumn Header="CAMERA" Binding="{Binding Camera}" Width="90"/><DataGridTextColumn Header="NIGHT" Binding="{Binding Night}" Width="100"/><DataGridTextColumn Header="EXPOSURE" Binding="{Binding ExposureText}" Width="80"/><DataGridTextColumn Header="FILE" Binding="{Binding OriginalName}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid></Border>
    <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="ImportDetailsLabel" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="Select a capture to see its review category and reason." TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,9"/><DockPanel Grid.Row="1"><Button DockPanel.Dock="Left" x:Name="ImportButton" Content="Import 0 files" Background="{DynamicResource Accent}" Foreground="White" BorderBrush="{DynamicResource Accent}"/><Button DockPanel.Dock="Right" x:Name="ImportColumnsButton" Content="Columns ▾" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" x:Name="ImportToolsButton" Content="Import tools ▾" Margin="0"/><TextBlock Text="Imports the ready files shown above." VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0"/></DockPanel></Grid>
   </Grid></TabItem>
   <TabItem Header="Mosaics"><Grid Margin="0,12,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><Button x:Name="NewMosaicButton" Content="New mosaic…"/><Button x:Name="DetectMosaicsButton" Content="Detect from metadata"/><Button x:Name="AssignMosaicButton" Content="Assign library selection…"/><Button x:Name="MosaicExportButton" Content="Export collection…"/><Button x:Name="MosaicToolsButton" Content="Tools ▾"/></WrapPanel>
    <TextBlock Grid.Row="1" x:Name="MosaicSummaryLabel" Text="Collections link captures across targets and nights. Detection reuses metadata; plate solving is optional." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,12"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions><TextBlock Text="COLLECTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><ListBox Grid.Row="1" x:Name="MosaicCollectionsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="8" Margin="0,10,0,0" ClipToBounds="True"><Canvas x:Name="MosaicMap" Width="230" Height="180" HorizontalAlignment="Center"/></Border></Grid>
     <Grid Grid.Column="1" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PANELS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><ListBox Grid.Row="1" x:Name="MosaicPanelsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><DataGrid x:Name="MosaicGrid"><DataGrid.Columns>
      <DataGridTextColumn Header="FILE" Binding="{Binding Filename}" Width="*" MinWidth="200"/><DataGridTextColumn Header="PANEL / ROLE" Binding="{Binding Panel}" Width="Auto" MinWidth="160"/><DataGridTextColumn Header="MEMBERSHIP" Binding="{Binding State}" Width="Auto" MinWidth="120"/><DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="Auto" MinWidth="90"/><DataGridTextColumn Header="NIGHT" Binding="{Binding Night}" Width="Auto" MinWidth="115"/><DataGridTextColumn Header="FILTER" Binding="{Binding Filter}" Width="Auto" MinWidth="110"/>
     </DataGrid.Columns></DataGrid></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MosaicDetailsLabel" Text="Select a collection to review its panels and evidence." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><WrapPanel Grid.Column="1"><Button x:Name="MosaicConfirmButton" Content="Confirm selected"/><Button x:Name="MosaicRemoveButton" Content="Remove selected"/></WrapPanel></Grid>
   </Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="3" Margin="0,10,0,0"><Expander Header="Performance details" FontSize="11" Foreground="{DynamicResource Muted}"><DataGrid x:Name="MetricsGrid" MaxHeight="135" MinHeight="80" RowHeight="25" FontSize="11" Margin="0,7,0,8"><DataGrid.Columns><DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="*"/><DataGridTextColumn Header="FILES" Binding="{Binding Files}" Width="75"/><DataGridTextColumn Header="SECONDS" Binding="{Binding Seconds, StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="FILES/S" Binding="{Binding FilesPerSecond, StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="MB/S" Binding="{Binding MBPerSecond, StringFormat=0.00}" Width="90"/></DataGrid.Columns></DataGrid></Expander>
   <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock x:Name="RateLabel" Text="Rates and estimated time appear during processing." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><ProgressBar x:Name="ProgressBar" Grid.Column="1" Height="6" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" BorderThickness="0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="PerformanceButton" Content="Report" Padding="12,5" Margin="12,0,0,0"/><Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Padding="12,5" Margin="8,0,0,0"/></StackPanel></Grid>
  </StackPanel>
 </Grid>
</Window>
