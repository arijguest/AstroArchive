  </StackPanel>
  <StackPanel Visibility="Collapsed" x:Name="MenuActionControls">
      <TextBlock x:Name="SelectionLabel" Text="Ctrl / Shift to select · Right-click for file actions" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource UiFontSmall}" VerticalAlignment="Center" />

   <Button x:Name="CoffeeButton" Content="☕ Buy me a coffee" Background="{DynamicResource Selection}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" FontSize="{DynamicResource UiFontControl}" Padding="14,7" Margin="0,0,10,0" />
   <Button x:Name="ThemeButton" Content="◐" ToolTip="Switch light / dark mode" Padding="10,6" />
   <Button x:Name="SettingsButton" Content="Settings" />
   <Button x:Name="HelpButton" Content="Guide" Margin="0" />
   <Button x:Name="LibraryColumnsButton" Content="Columns ▾" />
   <Button x:Name="PreviewToggle" Content="Preview" />
   <Button x:Name="MoreButton" Content="Tools ▾" Margin="0" />
   <Button x:Name="LibraryFiltersButton" Grid.Column="1" Content="Filters" Margin="8,0,0,0" />
   <Button x:Name="ReviewLibraryButton" Content="Review flagged" />
   <Button x:Name="ScreenLibraryButton" Content="Screen for failures" ToolTip="Check selected or visible indexed captures for rejection markers and damaged FITS data." />
   <Button x:Name="RotationButton" Content="Rotation" Padding="10,5" />
   <Button x:Name="SolveButton" Content="Identify target" Padding="10,5" />
   <Button x:Name="EditButton" Content="Edit metadata" Padding="10,5" Margin="0" />
   <Button x:Name="SaveTelescopeButton" Content="Save telescope" Padding="10,6" />
   <Button x:Name="RenameTelescopeButton" Content="Rename" Padding="10,6" />
   <Button x:Name="RebuildTelescopesButton" Content="Recover profiles" Padding="10,6" />
   <Button x:Name="RefreshUsbButton" Content="Refresh USB" Padding="10,6" Margin="0" />
   <Button DockPanel.Dock="Right" x:Name="AutoUploadButton" Content="Auto upload from USB" Visibility="Collapsed" Background="{DynamicResource Accent}" Foreground="White" Margin="8,0,0,0" />
   <Button Grid.Column="1" x:Name="ImportFiltersButton" Content="Filters" Margin="8,0,0,0" />
   <Button Grid.Column="3" x:Name="ScreenImportsButton" Content="Screen for failures" Margin="8,0,0,0" ToolTip="Check the visible captures for telescope failure/rejection markers and unreadable FITS data." />
   <CheckBox x:Name="SkipFlaggedCheck" Content="Skip flagged captures" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,8" />
   <Button x:Name="ReviewImportsButton" Content="Review flagged captures" Padding="12,6" Margin="0,0,8,8" />
   <Button x:Name="RetryImportsButton" Content="Retry failed imports" Padding="12,6" Margin="0,0,0,8" />
   <Button DockPanel.Dock="Right" x:Name="ImportColumnsButton" Content="Columns ▾" Margin="8,0,0,0" />
   <Button DockPanel.Dock="Right" x:Name="ImportToolsButton" Content="Import tools ▾" Margin="0" />
   <Button x:Name="NewMosaicButton" Content="New mosaic…" />
   <Button x:Name="DetectMosaicsButton" Content="Detect from metadata" />
   <Button x:Name="AssignMosaicButton" Content="Assign repository selection…" />
   <Button x:Name="MosaicToolsButton" Content="Tools ▾" />
   <Button x:Name="MosaicConfirmButton" Content="Confirm selected" />
   <Button x:Name="MosaicRemoveButton" Content="Remove selected" />
   <Button x:Name="PerformanceButton" Content="Report" Padding="12,5" Margin="12,0,0,0" />
   <Expander Grid.Row="1" Header="Import options" Margin="4,10,4,10" Foreground="{DynamicResource Muted}" x:Name="ImportOptionsControls">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
     <StackPanel>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0">
        <TextBlock Text="MODEL" FontSize="{DynamicResource UiFontCaption}" />
        <ComboBox x:Name="ModelBox" Margin="0,5,0,0" ToolTip="Auto detects the model from each capture." />
       </StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="CAMERA" FontSize="{DynamicResource UiFontCaption}" />
        <ComboBox x:Name="CameraBox" Margin="0,5,0,0" />
       </StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,12,0">
        <TextBlock Text="TARGET ANALYSIS" FontSize="{DynamicResource UiFontCaption}" />
        <ComboBox x:Name="ImportSolveMode" Margin="0,5,0,0" />
       </StackPanel>
       <StackPanel Grid.Column="3">
        <TextBlock Text="ROTATION ANALYSIS" FontSize="{DynamicResource UiFontCaption}" />
        <ComboBox x:Name="ImportRotationMode" Margin="0,5,0,0" />
       </StackPanel>
      </Grid>
      <CheckBox x:Name="IgnoreFailedCheck" IsChecked="False" Content="Ignore failed" Margin="0,12,0,0" ToolTip="Skip FITS filenames containing 'failed' anywhere, regardless of case. Saved for future folder, USB and Dump imports. Ignored source files are kept." />
      <CheckBox x:Name="DeleteOriginalsCheck" IsChecked="False" Content="Delete originals after verified import" Margin="0,10,0,0" ToolTip="Off by default. Removes newly imported source FITS only after verification and indexing. Cloud-synced source deletions propagate." />
      <TextBlock Text="Originals are kept by default. Optional analysis can take longer." FontSize="{DynamicResource UiFontSmall}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
     </StackPanel>
    </Border>
   </Expander>
   <ComboBox Width="190" x:Name="LibraryViewBox" Grid.Column="3" Margin="12,0,0,0" ToolTip="Browse individual files, targets or observing sessions." />
  </StackPanel>
 </Grid>
</Window>
