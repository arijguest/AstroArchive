<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AstroArchive · Remote tester" Width="1280" Height="880" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Background" Value="{DynamicResource DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource DisabledText}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}" Background="{DynamicResource SurfaceAlt}"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,6,30,6"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{DynamicResource Surface}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAlt}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="RowHeight" Value="32"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="18,24"><StackPanel DockPanel.Dock="Top"><Image x:Name="BrandLogo" Width="74" Height="74" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="AstroArchive" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Download tester" Style="{StaticResource Muted}" Margin="0,4,0,30"/><Border Background="{DynamicResource Selection}" CornerRadius="5" Padding="12,10"><TextBlock Text="Remote" FontWeight="SemiBold"/></Border></StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="Downloads only" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Keep shooting in your telescope app. Originals stay on the telescope. Your archive is not opened." Style="{StaticResource Muted}"/><TextBlock Text="Windows 10 / 11 · x64" FontSize="11" Style="{StaticResource Muted}"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Width="125"><TextBlock Text="Appearance" FontSize="11"/><ComboBox x:Name="ThemeBox"/></StackPanel><StackPanel><TextBlock Text="Remote" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Connect to a telescope and download completed exposures as they arrive." Style="{StaticResource Muted}" Margin="0,5,16,0"/></StackPanel></DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1  Set up file access" Style="{StaticResource Heading}"/><TextBlock Text="Telescope / connection"/><ComboBox x:Name="KindBox"/><TextBlock Text="Network connection"/><ComboBox x:Name="NetworkBox"/><TextBlock x:Name="SetupGuide" Margin="0,4,0,12"/><WrapPanel><Button x:Name="WifiButton" Content="Wi-Fi settings"/><Button x:Name="AddressesButton" Content="Show PC addresses"/><Button x:Name="GuideButton" Content="Manufacturer guide"/></WrapPanel><TextBlock x:Name="AddressesText" Style="{StaticResource Muted}" Visibility="Collapsed"/><TextBlock Text="2  Find the telescope address" Style="{StaticResource Heading}" Margin="0,12,0,10"/><TextBlock x:Name="IpGuide"/><Button x:Name="DefaultsButton" Content="Use hotspot defaults" Margin="0,12,0,8" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Try it without a telescope" Style="{StaticResource Heading}"/><TextBlock Text="Generate 12 unique FITS exposures into a separate local source folder. Start watching to see them arrive. No Python or FTP server is needed." Style="{StaticResource Muted}"/><Button x:Name="SimulatorButton" Content="Start local simulator" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="3  Connect and choose a folder" Style="{StaticResource Heading}"/><TextBlock Text="Telescope IPv4 address"/><TextBox x:Name="HostBox"/><Grid x:Name="FtpCredentials"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Port"/><TextBox x:Name="PortBox" Text="21"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Username"/><TextBox x:Name="UserBox" Text="anonymous"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Password"/><PasswordBox x:Name="PasswordBox"/></StackPanel></Grid><TextBlock Text="Source folder"/><TextBox x:Name="FolderBox"/><TextBlock x:Name="FolderHint" Style="{StaticResource Muted}"/><WrapPanel><Button x:Name="TestButton" Content="Test connection / list" Style="{StaticResource Primary}"/><Button x:Name="ParentButton" Content="Parent folder"/><Button x:Name="SourceBrowseButton" Content="Browse…"/></WrapPanel><DataGrid x:Name="FolderGrid" Height="138" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Folder / file" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/></DataGrid.Columns></DataGrid><TextBlock Text="Double-click a folder to enter it. Only this folder and its subfolders will be watched." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="4  Choose where downloads go" Style="{StaticResource Heading}"/><TextBox x:Name="DestinationBox"/><WrapPanel><Button x:Name="DestinationBrowseButton" Content="Choose folder…"/><Button x:Name="OpenButton" Content="Open downloads"/></WrapPanel><CheckBox x:Name="ExistingCheck" Content="Include exposures already in the selected folder" IsChecked="True"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Poll interval (seconds)"/><TextBox x:Name="PollBox" Text="5"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Download limit"/><ComboBox x:Name="LimitBox"/></StackPanel></Grid><TextBlock Text="Individual FITS exposures only. Live stacks, compressed FITS, videos and session sidecars are excluded in this tester." Style="{StaticResource Muted}"/></StackPanel></Border>
     </StackPanel>
    </Grid>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="5  Watch downloads" Style="{StaticResource Heading}"/><TextBlock x:Name="SummaryText" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></DockPanel><WrapPanel><Button x:Name="StartButton" Content="Start watching" Style="{StaticResource Primary}"/><Button x:Name="StopButton" Content="Stop" IsEnabled="False"/><Button x:Name="VerifyButton" Content="Verify downloads"/><Button x:Name="ReportButton" Content="Export test report…"/></WrapPanel><DataGrid x:Name="FilesGrid" Height="240"><DataGrid.Columns><DataGridTextColumn Header="Exposure" Binding="{Binding File}" Width="2*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/><DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*"/></DataGrid.Columns></DataGrid><TextBlock Text="Completed files are checked for FITS structure and assigned a local SHA-256 hash. Source equality needs a separate comparison with the telescope originals." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connection help" Style="{StaticResource Heading}"/><TextBlock Text="Connection refused / timeout: confirm the PC is on the telescope hotspot or the same home network. Recheck the telescope IP after reconnecting. FTP needs passive data connections as well as port 21; a successful ping alone does not prove file access.&#10;&#10;Seestar access denied: open the network folder in File Explorer and authenticate there if prompted. Some Windows installations block guest SMB access. This tester does not change Windows security settings; follow your telescope's current instructions or use a supported file-access method.&#10;&#10;Waiting / Retry: a file may still be written, the link may have dropped, or the file may be invalid. The next poll retries it. If downloads build up, increase the limit after checking capture cadence. Stop is safe; completed downloads remain.&#10;&#10;Testing: compare a session with downloads off and on, then independently copy originals after capture and compare their hashes. Check reconnect, stop/restart, and newly added session folders."/></StackPanel></Border>
    <TextBox x:Name="ActivityBox" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="5" Padding="12,10" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Choose a connection type, follow the setup guide, then test the connection."/></Border>
  </Grid>
 </Grid>
</Window>
