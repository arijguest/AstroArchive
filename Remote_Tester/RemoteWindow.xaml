<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AstroArchive.Remote;assembly=AstroArchive.RemoteTester" Title="AstroArchive · Remote tester 0.2.1" Width="1280" Height="880" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
 <Window.Resources>
  <local:KindLabelConverter x:Key="KindLabels"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Background" Value="{DynamicResource DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource DisabledText}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}" Background="{DynamicResource SurfaceAlt}"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,6,30,6"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{DynamicResource Surface}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAlt}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="RowHeight" Value="34"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,22">
    <StackPanel DockPanel.Dock="Top">
     <Image x:Name="BrandLogo" Width="62" Height="62" HorizontalAlignment="Left" Margin="4,0,0,12"/>
     <TextBlock Text="AstroArchive" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,0"/>
     <TextBlock Text="Remote tester · 0.2.1" Style="{StaticResource MutedText}" Margin="4,4,0,24"/>
     <TextBlock Text="REMOTE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="8,0,0,10"/>
     <Button x:Name="NavConnection" Content="1   Connection" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button x:Name="NavDownloads" HorizontalContentAlignment="Left" Content="2   Downloads" Margin="0,0,0,8"/>
     <Button x:Name="NavHelp" HorizontalContentAlignment="Left" Content="3   Help &amp; diagnostics" Margin="0,0,0,8"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Button x:Name="SimulatorButton" Content="Try a local demo" Margin="0,0,0,12"/>
     <TextBlock Text="Keep shooting in your telescope app. Completed exposures are copied here; originals stay on the telescope." Style="{StaticResource MutedText}" FontSize="12"/>
     <TextBlock Text="Your archive stays separate." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,20,24,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16">
    <StackPanel DockPanel.Dock="Right" Width="116"><TextBlock Text="Appearance" FontSize="11" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="ThemeBox" AutomationProperties.Name="Appearance"/></StackPanel>
    <StackPanel Margin="0,0,16,0"><TextBlock x:Name="PageTitle" Text="Connect your telescope" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Find it on your network, then choose which exposures to download." Style="{StaticResource MutedText}" Margin="0,5,0,10"/>
     <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Selection}" CornerRadius="4" Padding="9,4"><TextBlock x:Name="ConnectionBadge" Text="Not connected" FontSize="11" FontWeight="SemiBold"/></Border><ProgressBar x:Name="BusyProgress" Width="70" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceAlt}"/></StackPanel>
    </StackPanel>
   </DockPanel>
   <Border x:Name="FeedbackPanel" Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAlt}" Visibility="Collapsed" Padding="14">
    <StackPanel><DockPanel><Button x:Name="DismissFeedbackButton" Content="Dismiss" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0"/><TextBlock x:Name="FeedbackTitle" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="FeedbackHint" Margin="0,6,0,0"/>
     <Expander Header="Technical details" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"><StackPanel><TextBox x:Name="ErrorDetailsBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/><Button x:Name="CopyErrorButton" Content="Copy details" HorizontalAlignment="Left"/></StackPanel></Expander>
    </StackPanel>
   </Border>
   <ScrollViewer x:Name="ConnectionPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Find your telescope" Style="{StaticResource Heading}"/>
       <TextBlock Text="Telescope"/><ComboBox x:Name="KindBox" AutomationProperties.Name="Telescope type"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource KindLabels}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
       <TextBlock Text="How are you connected?"/><ComboBox x:Name="NetworkBox" AutomationProperties.Name="Network connection"/>
       <TextBlock x:Name="SetupSummary" Style="{StaticResource MutedText}"/>
       <StackPanel x:Name="DiscoveryPanel">
        <TextBlock Text="Search this network"/><ComboBox x:Name="DiscoveryNetworkBox" DisplayMemberPath="Display" AutomationProperties.Name="Network to search"/>
        <WrapPanel><Button x:Name="DiscoverButton" Content="Find telescopes" Style="{StaticResource Primary}"/><Button x:Name="RefreshNetworksButton" Content="Refresh" ToolTip="Refresh the network list after changing Wi-Fi"/><Button x:Name="CancelDiscoveryButton" Content="Cancel" Visibility="Collapsed"/></WrapPanel>
        <TextBlock x:Name="DiscoveryStatus" Style="{StaticResource MutedText}" Text="Search takes about 8 seconds."/>
        <DataGrid x:Name="DiscoveryGrid" Height="144" SelectionMode="Single" AutomationProperties.Name="Discovered telescopes"><DataGrid.Columns><DataGridTextColumn Header="Telescope" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Address" Binding="{Binding Host}" Width="116"/></DataGrid.Columns></DataGrid>
        <Button x:Name="UseDiscoveryButton" Content="Connect to selected telescope" Style="{StaticResource Primary}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       </StackPanel>
       <Expander Header="Need help finding the address?" Foreground="{DynamicResource Text}" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="IpGuide" Style="{StaticResource MutedText}"/><WrapPanel><Button x:Name="DefaultsButton" Content="Use hotspot address"/><Button x:Name="WifiButton" Content="Wi-Fi settings"/><Button x:Name="AddressesButton" Content="PC addresses"/></WrapPanel><TextBlock x:Name="AddressesText" Style="{StaticResource MutedText}" Visibility="Collapsed"/></StackPanel></Expander>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Choose the capture folder" Style="{StaticResource Heading}"/>
       <TextBlock Text="Telescope address"/><TextBox x:Name="HostBox" AutomationProperties.Name="Telescope IPv4 address"/>
       <StackPanel x:Name="SmbOptions"><TextBlock Text="File access"/><ComboBox x:Name="SmbModeBox" AutomationProperties.Name="Seestar file access"/><TextBlock x:Name="SmbAccessHint" Style="{StaticResource MutedText}"/></StackPanel>
       <Expander x:Name="FtpCredentials" Header="FTP connection options" Foreground="{DynamicResource Text}" Margin="0,0,0,10"><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Port"/><TextBox x:Name="PortBox" Text="21"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Username"/><TextBox x:Name="UserBox" Text="anonymous"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Password"/><PasswordBox x:Name="PasswordBox"/></StackPanel></Grid></Expander>
       <TextBlock x:Name="SourceLabel" Text="Capture folder"/><TextBox x:Name="FolderBox" AutomationProperties.Name="Capture folder"/>
       <TextBlock x:Name="FolderHint" Style="{StaticResource MutedText}"/>
       <WrapPanel><Button x:Name="TestButton" Content="Connect &amp; browse" Style="{StaticResource Primary}"/><Button x:Name="ParentButton" Content="Up one folder"/><Button x:Name="StorageRootButton" Content="Storage root"/><Button x:Name="SourceBrowseButton" Content="Browse…"/></WrapPanel>
       <DataGrid x:Name="FolderGrid" Height="154" SelectionMode="Single" AutomationProperties.Name="Telescope folders and files"><DataGrid.Columns><DataGridTextColumn Header="Folder / file" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="65"/></DataGrid.Columns></DataGrid>
       <TextBlock x:Name="FolderStatus" Text="Connect to see the folders available on your telescope." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Save downloads on this PC" Style="{StaticResource Heading}"/>
       <TextBox x:Name="DestinationBox" AutomationProperties.Name="Download destination"/>
       <WrapPanel><Button x:Name="DestinationBrowseButton" Content="Choose folder…"/><Button x:Name="OpenButton" Content="Open downloads"/></WrapPanel>
       <CheckBox x:Name="ExistingCheck" Content="Also download exposures already in this folder" IsChecked="True"/>
       <Expander Header="Download options" Foreground="{DynamicResource Text}"><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Check every (seconds)"/><TextBox x:Name="PollBox" Text="5"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Download speed limit"/><ComboBox x:Name="LimitBox"/></StackPanel></Grid></Expander>
      </StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <ScrollViewer x:Name="DownloadsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
    <StackPanel Margin="0,0,12,0">
     <UniformGrid Columns="3" Margin="0,0,0,16"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="DOWNLOADED" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="DownloadedCount" Text="0" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="WAITING / COPYING" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="WaitingCount" Text="0" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="NEEDS ATTENTION" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="AttentionCount" Text="0" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Exposures" Style="{StaticResource Heading}"/><TextBlock x:Name="SummaryText" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></DockPanel>
      <TextBlock x:Name="DownloadsEmpty" Text="No downloads yet. Connect to a capture folder, then start downloads. You can also try the local demo." Style="{StaticResource MutedText}"/>
      <DataGrid x:Name="FilesGrid" Height="300" AutomationProperties.Name="Exposure download progress"><DataGrid.Columns><DataGridTextColumn Header="Exposure" Binding="{Binding File}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="105"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="85"/><DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="Files wait for stable size and timestamps before copying. Completed files are checked for FITS structure and get a local SHA-256 receipt." Style="{StaticResource MutedText}" Margin="0,12,0,10"/>
      <WrapPanel><Button x:Name="VerifyButton" Content="Verify saved files"/><Button x:Name="ReportButton" Content="Export test report…"/></WrapPanel>
     </StackPanel></Border>
     <Expander Header="Activity log" Foreground="{DynamicResource Text}"><TextBox x:Name="ActivityBox" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="HelpPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
    <StackPanel Margin="0,0,12,0">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connect the telescope to your network" Style="{StaticResource Heading}"/><TextBlock x:Name="SetupGuide"/><Button x:Name="GuideButton" Content="Open manufacturer instructions" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Seestar without Windows policy changes" Style="{StaticResource Heading}"/><TextBlock Text="Choose Direct telescope access on the Connection page. The tester connects to Seestar itself, so Windows guest-login and signing settings can remain enabled. No PowerShell commands or administrator changes are needed.&#10;&#10;Seestar's guest file session is unsigned; use it on your trusted home network or telescope hotspot. Direct access supports SMB2/3 and reads files only. It cannot enable a guest share that the telescope's firmware does not provide.&#10;&#10;Windows file access is available as a compatibility option. A folder that opens in File Explorer can be used with that option; Windows policy restrictions still apply to it."/><Button x:Name="SmbGuideButton" Content="Seestar file-access guidance" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="If connection or discovery fails" Style="{StaticResource Heading}"/><TextBlock Text="Check that the PC and telescope share the same IPv4 subnet. Guest Wi-Fi, client isolation and separate VLANs can block discovery. Allow this app on your trusted private network if Windows asks; no router port forwarding is needed. Refresh the network list after changing Wi-Fi.&#10;&#10;No discovery reply: enter the telescope IP from its phone app or your router. Hotspot addresses are available under Need help finding the address?&#10;&#10;Folder not found: try Storage root, then double-click folders to choose your session. For Seestar, enable Save Each Frame in the phone app. For DWARF, choose the relevant DWARF_RAW session.&#10;&#10;Waiting or Retry: the exposure may still be written or the connection may have dropped. The tester retries automatically. Stop is safe; completed files remain. Verification uses saved local receipts and does not require the telescope online."/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="What to test" Style="{StaticResource Heading}"/><TextBlock Text="Try the demo first. Then compare capture sessions with downloads off and on; note cadence and phone-app responsiveness. Check Wi-Fi reconnect and stopping/restarting. Independently copy the telescope originals after capture and compare hashes. Export a report if anything fails.&#10;&#10;This tester copies individual uncompressed FITS exposures. Live stacks, compressed FITS, videos and session sidecars are excluded. It keeps your archive separate and never deletes telescope files.&#10;&#10;This unsigned test build may be blocked by Windows. Extract the entire ZIP so its companion files stay together. Caught startup errors are saved under %LOCALAPPDATA%\AstroArchive.RemoteTester and offer Copy details. The included diagnostics script can collect Windows startup events without changing settings."/></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><DockPanel><WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0"><Button x:Name="StartButton" Content="Start downloads" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="Stop" IsEnabled="False" Margin="0"/></WrapPanel><TextBlock x:Name="StatusText" Text="Find your telescope or enter its address, then connect to a capture folder." VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
